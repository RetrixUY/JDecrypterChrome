{
    "name": "JDecrypter",
    "version": "2.0",
    "author": "RetrixUY",
    "description": "Decrypts and Show JDownloader \"Click n' Load\" Buttons",
    "icons": {
        "128": "logo128.png",
        "48": "logo48.png",
        "32": "logo32.png",
        "16": "logo16.png"
    },
    "manifest_version": 3,
    "minimum_chrome_version": "102",
    "permissions": ["activeTab", "scripting"],
    "action": {
        "default_title": "JDecrypter",
        "default_popup": "popup.html"
    },
    "content_scripts": [{
        "matches": [
            "http://*/*",
            "https://*/*"
        ],
        "js": ["aes.js", "main.js"]
    }]
}
